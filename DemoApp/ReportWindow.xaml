<Window x:Class="DemoApp.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoApp"
        mc:Ignorable="d"
        Title="Отчет" Height="500" Width="400" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="ReportTextBlock" Grid.Row="0" Margin="4"></TextBlock>
        <StackPanel Orientation="Horizontal" Grid.Row="1"
                    HorizontalAlignment="Right">
            <TextBlock Name="TimeStampTextBlock" Margin="4"/>
            <Button Name="SaveReportButton" Click="SaveReportButton_Click" Content="Сохранить" Margin="4" IsEnabled="True"/>
            <Button Name="CloseWindow" Click="CloseWindow_Click"  Content="Закрыть" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
