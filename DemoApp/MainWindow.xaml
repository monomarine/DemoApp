<Window x:Class="DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoApp"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Учет оборудования" Height="450" Width="800">

      
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/> <!--поиск-->
            <RowDefinition Height="*"/> <!--остальное простраство datagrid-->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Margin="3">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox Name="SerachTextBox" Width="300"
                     Margin="3" VerticalContentAlignment="Center"
                     TextChanged="SerachTextBox_TextChanged"/>
            <!--не забудьте создать новый обработчик события-->

                <Button Content="Добавить" Margin="5" Name="CreateButton" Click="CreateButton_Click"/>
                <Button Content="Изменить" Margin="5" Name="UpdateButton" Click="UpdateButton_Click"/>
                <Button Content="Удалить" Margin="5" Name="DeleteButton" Click="DeleteButton_Click"/>
                <Button Content="Сформировать отчет" Margin="5" Name="ReportButton" Click="ReportButton_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Name="MainDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип оборудования" Binding="{Binding Type}" Width="200"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="150"/>
                <DataGridCheckBoxColumn Header="В использовании" Binding="{Binding IsInUse}" Width="100"/>
              
            </DataGrid.Columns>
        </DataGrid>
       

    </Grid>
</Window>
